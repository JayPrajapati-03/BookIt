{
  "name": "bookit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BookIt - Real-Time Hotel Booking Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan,magenta\" \"pnpm --filter @bookit/api dev\" \"pnpm --filter @bookit/web dev\"",
    "build": "pnpm --filter @bookit/shared build && pnpm --filter @bookit/api build && pnpm --filter @bookit/web build",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter @bookit/api test",
    "test:all": "pnpm -r test",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@12.10.1"
}
