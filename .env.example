# ==========================================
# BookIt Environment Variables Configuration
# ==========================================

# --- Server & Runtime Environment ---
# Node environment ('development' | 'production' | 'test')
NODE_ENV=development
# Port on which the Express & Socket.io server listens
PORT=4000
# Base public URL of the backend API
API_URL=http://localhost:4000
# Base public URL of the frontend web application (for CORS allowlist)
WEB_URL=http://localhost:5173

# --- Database (MongoDB) ---
# Connection string with replica set (required for transactions)
# Local: mongodb://127.0.0.1:27017/bookit?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/bookit?replicaSet=rs0

# --- Authentication & Tokens ---
# Secret key used to sign and verify short-lived access JWTs (15 min)
JWT_ACCESS_SECRET=bookit_super_secret_jwt_access_key_minimum_32_characters_long!
# Secret key used for signing/hashing refresh tokens and family verification
JWT_REFRESH_SECRET=bookit_super_secret_jwt_refresh_key_minimum_32_characters_long!
# Refresh token cookie domain (optional in development, set to domain in production)
COOKIE_DOMAIN=localhost

# --- Email Service (SMTP) ---
# SMTP host (default points to Mailpit in local dev)
SMTP_HOST=127.0.0.1
# SMTP port (1025 for Mailpit local development)
SMTP_PORT=1025
# SMTP authentication user
SMTP_USER=dev_user
# SMTP authentication password
SMTP_PASS=dev_pass
# Sender email address
EMAIL_FROM="BookIt Stays <noreply@bookit.internal>"

# --- Cloudinary Storage ---
# Cloudinary cloud name for media asset uploads
CLOUDINARY_CLOUD_NAME=bookit-demo
# Cloudinary API key
CLOUDINARY_API_KEY=123456789012345
# Cloudinary API secret
CLOUDINARY_API_SECRET=sample_cloudinary_secret_key_here

# --- Application Business Rules & Defaults ---
# Minutes before an unpaid room hold automatically expires
HOLD_DURATION_MINUTES=10
# Standard Goods and Services Tax (GST) percentage applied to bookings
TAX_PERCENTAGE=18

# --- Demo & Development Modes ---
# When true, exposes 1-click role logins and prevents destructive operations on demo data
DEMO_MODE=true
